      "**/node_modules/electron-store/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
