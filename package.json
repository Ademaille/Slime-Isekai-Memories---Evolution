{
  "name": "evolution",
  "version": "1.0.0",
  "description": "Suivi des personnages",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.evolution.tracker",
    "files": [
      "**/*"
    ],
    "asar": true,
